{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8081
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "site": "passpilot-app",
    "public": "../web-dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.ipa",
      "**/*.exe",
      "**/*.dll",
      "**/*.bat"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com/firebasejs/ https://apis.google.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https: data: blob:; worker-src 'self' blob:; frame-src 'self' blob: https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/download/PassPilot-Test.apk",
        "destination": "https://github.com/dayplayer100-boop/PassPilot/releases/download/v1.24.0-test/PassPilot-1.24-Test.apk",
        "type": 302
      },
      {
        "source": "/download/PassPilot-Test-32bit.apk",
        "destination": "https://github.com/dayplayer100-boop/PassPilot/releases/download/v1.24.0-test/PassPilot-1.24-Test-32bit.apk",
        "type": 302
      }
    ]
  }
}
